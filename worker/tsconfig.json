{
  "extends": "../shared/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["jest", "node"],
    "paths": {
      "@microservices/shared": ["../shared/src/index.ts"],
      "@microservices/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../shared" }]
}
