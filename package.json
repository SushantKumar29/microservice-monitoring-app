{
  "name": "microservice-monitoring-app",
  "version": "1.0.0",
  "private": true,
  "description": "Kubernetes Microservices Monitoring System",
  "scripts": {
    "prepare": "husky install",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "npm run type-check --workspaces --if-present",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@microservices/shared",
    "clean": "npm run clean --workspaces --if-present",
    "dev:submitter": "npm run dev --workspace=submitter",
    "dev:worker": "npm run dev --workspace=worker",
    "dev:stats": "npm run dev --workspace=stats",
    "dev": "concurrently \"npm run dev:submitter\" \"npm run dev:worker\" \"npm run dev:stats\"",
    "test": "npm run test:submitter && npm run test:worker && npm run test:stats",
    "test:submitter": "cd submitter && npm test",
    "test:worker": "cd worker && npm test",
    "test:stats": "cd stats && npm test",
    "test:coverage": "npm run test -- --coverage",
    "test:watch": "npm run test -- --watch"
  },
  "workspaces": [
    "shared",
    "submitter",
    "worker",
    "stats"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SushantKumar29/microservice-monitoring-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/SushantKumar29/microservice-monitoring-app/issues"
  },
  "homepage": "https://github.com/SushantKumar29/microservice-monitoring-app#readme",
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0"
  }
}
